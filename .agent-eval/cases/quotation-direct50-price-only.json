{
  "id": "quotation-direct50-price-only",
  "title": "直接50 仅查价（无库存）",
  "objective": "基于 match + supplier-hybrid + select 工具链返回推荐价 + 货源（名录）三段式回复；禁止调用 inventory / get_inventory / search_inventory / fill_quotation_sheet；assistant.message 须含锁码 8020020755 + ≥3 名录 name_zh；禁止 A/B/C 菜单式追问。",
  "prompt": "查询直接 50 的 B 级价格。",
  "risk_level": "read_only",
  "agent": {
    "id": "quotation-agent",
    "adapter": "ccb-acp"
  },
  "ideal_process": [
    "quotation.match",
    "tool.mcp__supplier-directory__suppliers_hybrid_match",
    "quotation.select",
    "assistant.message"
  ],
  "graders": [
    {
      "id": "required_actions",
      "type": "tool_presence",
      "severity": "hard",
      "config": {
        "actions": [
          "quotation.match",
          "tool.mcp__supplier-directory__suppliers_hybrid_match",
          "quotation.select"
        ]
      }
    },
    {
      "id": "forbidden_actions",
      "type": "tool_forbidden",
      "severity": "hard",
      "config": {
        "actions": [
          "agent.delegate",
          "inventory.query",
          "quotation.search_inventory",
          "tool.mcp__quotation__get_inventory_by_code",
          "tool.mcp__quotation__get_inventory_by_code_batch",
          "tool.mcp__quotation__fill_quotation_sheet"
        ]
      }
    },
    {
      "id": "discouraged_actions",
      "type": "tool_forbidden",
      "severity": "soft",
      "config": {
        "actions": [
          "tool.mcp__quotation__get_product_price_tiers"
        ]
      }
    },
    {
      "id": "golden_sequence",
      "type": "sequence",
      "severity": "hard",
      "config": {
        "actions": [
          "quotation.match",
          "quotation.select",
          "assistant.message"
        ]
      }
    },
    {
      "id": "business_arguments",
      "type": "tool_args",
      "severity": "hard",
      "config": {
        "assertions": [
          {
            "action": "quotation.match",
            "path": "input.customer_level",
            "operator": "equals",
            "value": "B"
          }
        ]
      }
    },
    {
      "id": "evidence_provenance",
      "type": "evidence_link",
      "severity": "hard",
      "config": {
        "assertions": [
          {
            "source": "quotation.match.output.results[*].candidates[*].code",
            "target": "quotation.select.output.selections[*].code",
            "operator": "contains"
          },
          {
            "source": "quotation.select.input.items[*].candidates[*].code",
            "target": "quotation.match.output.results[*].candidates[*].code",
            "operator": "contains"
          }
        ]
      }
    }
  ],
  "judge": {
    "mode": "current_ai_process",
    "required": true,
    "rubric": [
      {
        "id": "requirement_satisfaction",
        "description": "是否完整满足仅查价的需求（不画蛇添足 fill_quotation_sheet）",
        "weight": 30
      },
      {
        "id": "selection_reasoning",
        "description": "是否经 select_quotation_candidates 锁码 8020020755 且 reason 合理",
        "weight": 30
      },
      {
        "id": "supplier_sourcing",
        "description": "是否在回复中体现货源（名录）段且至少 3 个 name_zh",
        "weight": 25
      },
      {
        "id": "no_clarification_dump",
        "description": "是否未用 A/B/C 菜单式追问或甩锅（依据 L1 § 查后多候选 BAD 形态）",
        "weight": 15
      }
    ],
    "threshold": 80
  },
  "decision": {
    "policy": "all_hard_and_soft_threshold",
    "hard": {
      "require": "all"
    },
    "soft": {
      "aggregate": "weighted_average",
      "threshold": 80
    }
  },
  "trials": {
    "count": 3,
    "metrics": [
      "pass_at_1",
      "pass_at_3",
      "pass_power_3",
      "flaky_rate",
      "latency"
    ]
  },
  "schema_version": "eval.case/v1",
  "status": "locked",
  "notes": "Generated by 07-21-quotation-relay-stale-fix. New case covering 'price only' (no inventory) path. Sibling: quotation-direct50-price-stock.json. Guards: (1) sub-agent calling fill_quotation_sheet when user only asked for price → forbidden_actions hard fail; (2) sub-agent omitting supplier sourcing section → evidence_provenance hard fail; (3) sub-agent falling back to A/B/C menu when select returns ok → soft rubric 'no_clarification_dump' (weight 15%); (4) sub-agent using wrong customer_level → business_arguments hard fail. Dropped reply_shape_no_ab_menu structured_output grader (only handles assistant.table, not text).",
  "confirmed_at": "2026-07-20T03:08:07.563Z",
  "case_hash": "sha256:32d0e11320cd4ff5154656b7e89da49cf47ecb4c61424ed804fb2618763b3794"
}
