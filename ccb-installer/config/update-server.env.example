# WanD update server (copy to %LOCALAPPDATA%\CCB-Wanding\config\update-server.env)
# ccb-launch-aionui.cmd loads this before starting AionUI.
#
# Production VPS:
AIONUI_DISABLE_AUTO_UPDATE=1
AIONUI_UPDATE_MANIFEST_URL=http://67.216.206.3/updates/manifest.json
CCB_UPDATE_MANIFEST_URL=http://67.216.206.3/updates/manifest.json

# Force GitHub (dev only — do not ship to employees):
# AIONUI_USE_GITHUB_UPDATE=1
