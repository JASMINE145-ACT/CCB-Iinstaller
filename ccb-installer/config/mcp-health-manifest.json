{
  "schema_version": 1,
  "description": "Platform and reusable-capability MCP health registry. Vertical package health is composed at runtime.",
  "package_health_manifests": [
    "packages/vertical/com.wanding.trade/health/mcp-health-manifest.json"
  ],
  "mcp_servers": {
    "office-word": {
      "kind": "stdio",
      "lazy": false,
      "required_paths": [
        "vendor/python-wanding/python.exe",
        "vendor/mcp-servers/office-word-mcp/server.py",
        "vendor/mcp-servers/office-word-mcp/site-packages"
      ],
      "tool_prefix": "mcp__office-word__",
      "probe_timeout_ms": 90000,
      "probe_tool_call": {
        "tool": "list_available_documents",
        "arguments": {
          "directory": "."
        }
      }
    },
    "excel": {
      "kind": "stdio",
      "lazy": false,
      "required_paths": [
        "vendor/python-wanding/python.exe",
        "vendor/mcp-servers/excel-mcp-server/server.py",
        "vendor/mcp-servers/excel-mcp-server/site-packages"
      ],
      "tool_prefix": "mcp__excel__",
      "probe_timeout_ms": 45000,
      "probe_tool_call": {
        "tool": "create_workbook",
        "arguments": {
          "filepath": "ccb-health-probe.xlsx"
        }
      }
    },
    "excel-mcp": {
      "kind": "stdio",
      "lazy": true,
      "required_paths": [
        "vendor/mcp-servers/excel-mcp/mcp-excel.exe"
      ],
      "tool_prefix": "mcp__excel-mcp__",
      "probe_timeout_ms": 120000,
      "optional": true
    },
    "exa": {
      "kind": "http",
      "lazy": true,
      "optional": true
    },
    "tavily": {
      "kind": "http",
      "lazy": true,
      "optional": true
    },
    "scrapling": {
      "kind": "stdio",
      "lazy": true,
      "optional": true,
      "notes": "Extended research profile — register via install-research-toolstack.ps1"
    }
  },
  "optional_checks": {
    "exa": {
      "expected_url": "https://mcp.exa.ai/mcp",
      "http_probe_timeout_sec": 8
    },
    "tavily": {
      "expected_url_prefix": "https://mcp.tavily.com/mcp",
      "http_probe_timeout_sec": 8
    },
    "skills": {
      "ppt-master": {
        "config_rel": "skills/ppt-master/SKILL.md",
        "vendor_rel": "vendor/ppt-master-skill/SKILL.md"
      }
    }
  },
  "agent_profiles": {
    "word-creator": {
      "required_mcp": [
        "office-word"
      ],
      "tool_prefixes": [
        "mcp__office-word__"
      ]
    },
    "excel-creator": {
      "required_mcp": [
        "excel"
      ],
      "tool_prefixes": [
        "mcp__excel__"
      ]
    },
    "ppt-creator": {
      "required_mcp": [],
      "skills": [
        "ppt-master"
      ],
      "optional": true
    },
    "research-agent": {
      "required_mcp": [
        "exa"
      ],
      "tool_prefixes": [
        "mcp__exa__",
        "mcp__tavily__"
      ],
      "optional_mcp": [
        "tavily",
        "scrapling"
      ],
      "notes": "Base profile: exa + tavily (tavily optional WARN). Extended adds scrapling when registered."
    }
  }
}
