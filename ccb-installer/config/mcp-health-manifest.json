{
  "schema_version": 1,
  "description": "CCB-Wanding MCP health registry — config paths, agent allowlists, probe expectations.",
  "mcp_servers": {
    "quotation": {
      "kind": "stdio",
      "lazy": false,
      "required_paths": [
        "vendor/bun/bun.exe",
        "vendor/mcp-servers/quotation-server/dist/index.js",
        "vendor/python-wanding/python.exe",
        "vendor/wanding/data",
        "vendor/wanding/python/main.py",
        "vendor/wanding/.env.accurate"
      ],
      "tool_prefix": "mcp__quotation__",
      "probe_timeout_ms": 90000,
      "probe_tool_call": {
        "tool": "match_quotation",
        "arguments": {
          "keywords": "pipe",
          "showAllCandidates": true
        }
      },
      "probe_inventory_call": {
        "tool": "get_inventory_by_code",
        "arguments": {
          "code": "HEALTH-PROBE"
        },
        "reject_patterns": [
          "inventory_unavailable",
          "not configured",
          "AOL_ACCESS_TOKEN"
        ]
      }
    },
    "accurate": {
      "kind": "stdio",
      "lazy": false,
      "required_paths": [
        "vendor/python-wanding/python.exe",
        "vendor/mcp-servers/accurate-mcp/server.py"
      ],
      "tool_prefix": "mcp__accurate__",
      "probe_timeout_ms": 120000,
      "probe_tool_call": {
        "tool": "accurate_summarize_records",
        "arguments": {
          "table_name": "purchase-invoice",
          "start_date": "01/01/2026",
          "end_date": "31/01/2026",
          "group_by": "month",
          "page_size": 10,
          "max_pages": 1
        },
        "reject_patterns": [
          "AOL_ACCESS_TOKEN 未设置",
          "AOL_SIGNATURE_SECRET 未设置",
          "AOL_DATABASE_ID 未设置",
          "[参数错误]",
          "[API 错误]"
        ]
      }
    },
    "office-word": {
      "kind": "stdio",
      "lazy": false,
      "required_paths": [
        "vendor/python-wanding/python.exe",
        "vendor/mcp-servers/office-word-mcp/server.py",
        "vendor/mcp-servers/office-word-mcp/site-packages"
      ],
      "tool_prefix": "mcp__office-word__",
      "probe_timeout_ms": 90000,
      "probe_tool_call": {
        "tool": "list_available_documents",
        "arguments": {
          "directory": "."
        }
      }
    },
    "excel": {
      "kind": "stdio",
      "lazy": false,
      "required_paths": [
        "vendor/python-wanding/python.exe",
        "vendor/mcp-servers/excel-mcp-server/server.py",
        "vendor/mcp-servers/excel-mcp-server/site-packages"
      ],
      "tool_prefix": "mcp__excel__",
      "probe_timeout_ms": 45000,
      "probe_tool_call": {
        "tool": "create_workbook",
        "arguments": {
          "filepath": "ccb-health-probe.xlsx"
        }
      }
    },
    "excel-mcp": {
      "kind": "stdio",
      "lazy": true,
      "required_paths": [
        "vendor/mcp-servers/excel-mcp/mcp-excel.exe"
      ],
      "tool_prefix": "mcp__excel-mcp__",
      "probe_timeout_ms": 120000,
      "optional": true
    },
    "exa": {
      "kind": "http",
      "lazy": true,
      "optional": true
    },
    "scrapling": {
      "kind": "stdio",
      "lazy": true,
      "optional": true,
      "notes": "Extended research profile — register via install-research-toolstack.ps1"
    },
    "price-library": {
      "kind": "stdio",
      "lazy": false,
      "required_paths": [
        "vendor/bun/bun.exe",
        "vendor/mcp-servers/price-library-server/dist/index.js",
        "vendor/python-wanding/python.exe",
        "vendor/wanding/python/price_library_main.py"
      ],
      "tool_prefix": "mcp__price-library__",
      "probe_timeout_ms": 60000,
      "probe_tool_call": {
        "tool": "get_price_library_active",
        "arguments": {}
      },
      "notes": "Read probe works for any org-authenticated user. Draft/write tools require price_admin (403 otherwise)."
    }
  },
  "optional_checks": {
    "exa": {
      "expected_url": "https://mcp.exa.ai/mcp",
      "http_probe_timeout_sec": 8
    },
    "skills": {
      "ppt-master": {
        "config_rel": "skills/ppt-master/SKILL.md",
        "vendor_rel": "vendor/ppt-master-skill/SKILL.md"
      }
    }
  },
  "agent_profiles": {
    "wande-orchestrator": {
      "required_mcp": [],
      "forbidden_mcp": ["quotation", "accurate", "office-word", "excel"],
      "notes": "Router session — MCP filtered to empty allowlist"
    },
    "quotation-agent": {
      "required_mcp": ["quotation", "excel"],
      "tool_prefixes": ["mcp__quotation__", "mcp__excel__"]
    },
    "accurate-agent": {
      "required_mcp": ["accurate"],
      "tool_prefixes": ["mcp__accurate__"]
    },
    "word-creator": {
      "required_mcp": ["office-word"],
      "tool_prefixes": ["mcp__office-word__"]
    },
    "excel-creator": {
      "required_mcp": ["excel"],
      "tool_prefixes": ["mcp__excel__"]
    },
    "ppt-creator": {
      "required_mcp": [],
      "skills": ["ppt-master"],
      "optional": true
    },
    "research-agent": {
      "required_mcp": ["exa"],
      "tool_prefixes": ["mcp__exa__"],
      "optional_mcp": ["scrapling"],
      "notes": "Base profile: exa only. Extended adds scrapling when registered."
    },
    "price-library-agent": {
      "required_mcp": ["price-library"],
      "tool_prefixes": ["mcp__price-library__"],
      "optional_mcp": ["excel"],
      "notes": "Guid-only price_admin specialist — delegatable false"
    }
  }
}
