# Copy to env.local (gitignored) and fill in values. Never commit env.local.
#
#   cp scripts/org-phase0/env.example scripts/org-phase0/env.local
#   # edit env.local

ORG_CENTER_URL=http://67.216.206.3:13401
ORG_ADMIN_USER=admin
ORG_ADMIN_PASSWORD=

# Employee account — must match local AionUI login credentials
EMPLOYEE_USERNAME=
EMPLOYEE_PASSWORD=
EMPLOYEE_ROLE=employee

# Optional: restrict ufw on VPS to this public IP (employee office/home)
EMPLOYEE_PUBLIC_IP=

# Unified SSO — see phase1-jwt-secret-runbook.md (never commit real JWT_SECRET)
JWT_SECRET=
AIONUI_SSO_MODE=org-idp
