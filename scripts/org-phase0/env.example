ORG_ADMIN_USER=admin
ORG_ADMIN_PASSWORD=CHANGE_ME

EMPLOYEE_USERNAME=employee_username
EMPLOYEE_PASSWORD=CHANGE_ME
EMPLOYEE_ROLE=employee

EMPLOYEE_PUBLIC_IP=

JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48
AIONUI_SSO_MODE=org-idp
