# Org Phase 0 secrets — copy to env.local (gitignored). Never commit env.local.
# VPS mirror: /root/org-phase0.env (chmod 600)
#
#   cp scripts/org-phase0/env.local.example scripts/org-phase0/env.local
#   # edit env.local with real values

ORG_CENTER_URL=http://YOUR_ORG_HOST:13401
ORG_ADMIN_USER=admin
ORG_ADMIN_PASSWORD=CHANGE_ME

# Employee accounts — must match local AionUI login credentials
EMPLOYEE_USERNAME=employee_username
EMPLOYEE_PASSWORD=CHANGE_ME
EMPLOYEE_ROLE=employee

# Additional employees (optional): EMPLOYEE_<slug>_USERNAME / EMPLOYEE_<slug>_PASSWORD

# Optional: restrict ufw on VPS to this public IP
EMPLOYEE_PUBLIC_IP=

# Unified SSO — same value on VPS /etc/aionorg/env and employee sso.env (rotate before multi-tenant)
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48

AIONUI_SSO_MODE=org-idp
