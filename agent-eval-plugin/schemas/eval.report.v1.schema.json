{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eval.report/v1",
  "type": "object",
  "required": ["schema_version", "run_id", "case_id", "verdict", "judgment_status", "outcomes", "grader_results", "trace_refs", "metrics"],
  "properties": {
    "schema_version": { "const": "eval.report/v1" },
    "run_id": { "type": "string" },
    "case_id": { "type": "string" },
    "verdict": { "enum": ["PASS", "FAIL", "ERROR", "BLOCKED", "NEEDS_REVIEW"] },
    "judgment_status": { "enum": ["complete", "pending", "not_required"] },
    "outcomes": { "type": "array", "items": { "type": "object" } },
    "grader_results": { "type": "array", "items": { "type": "object" } },
    "judgments": { "type": "array", "items": { "type": "object" } },
    "trace_refs": { "type": "array", "items": { "type": "string" } },
    "metrics": { "type": "object" }
  }
}
