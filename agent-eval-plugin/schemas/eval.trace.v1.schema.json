{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eval.trace/v1",
  "type": "object",
  "required": ["schema_version", "trace_id", "case_id", "case_version", "adapter", "adapter_version", "agent_version", "model", "prompt_hash", "skill_hash", "knowledge_hash", "tools_hash", "environment_hash", "unavailable_reasons", "events", "artifacts", "metrics"],
  "properties": {
    "schema_version": { "const": "eval.trace/v1" },
    "trace_id": { "type": "string" },
    "case_id": { "type": "string" },
    "case_version": { "type": "string" },
    "adapter": { "type": "string" },
    "adapter_version": { "type": ["string", "null"] },
    "agent_version": { "type": ["string", "null"] },
    "model": { "type": ["string", "null"] },
    "prompt_hash": { "type": "string" },
    "skill_hash": { "type": ["string", "null"] },
    "knowledge_hash": { "type": ["string", "null"] },
    "tools_hash": { "type": ["string", "null"] },
    "environment_hash": { "type": ["string", "null"] },
    "unavailable_reasons": { "type": "object" },
    "events": { "type": "array", "items": { "type": "object" } },
    "artifacts": { "type": "array", "items": { "type": "object" } },
    "metrics": {
      "type": "object",
      "required": ["turns", "tool_calls", "latency_ms"],
      "properties": {
        "turns": { "type": "integer", "minimum": 0 },
        "tool_calls": { "type": "integer", "minimum": 0 },
        "latency_ms": { "type": "number", "minimum": 0 }
      }
    }
  }
}
